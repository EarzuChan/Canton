include(FetchContent)

file(READ "${CMAKE_CURRENT_LIST_DIR}/NativeDependencies.json" _canton_dependencies)
string(JSON _canton_dependency_schema GET "${_canton_dependencies}" schema)
if(NOT _canton_dependency_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported Canton native dependency manifest schema")
endif()
foreach(_canton_dependency IN ITEMS quickjs_ng)
    string(TOUPPER "${_canton_dependency}" _canton_dependency_name)
    string(JSON _canton_repository GET "${_canton_dependencies}" "${_canton_dependency}" repository)
    string(JSON _canton_ref GET "${_canton_dependencies}" "${_canton_dependency}" ref)
    set(CANTON_${_canton_dependency_name}_GIT_REPOSITORY "${_canton_repository}" CACHE STRING "Dependency git repository")
    set(CANTON_${_canton_dependency_name}_GIT_TAG "${_canton_ref}" CACHE STRING "Pinned dependency release tag")
endforeach()

function(canton_validate_dependency name source)
    string(TOLOWER "${name}" _canton_name)
    if(FETCHCONTENT_SOURCE_DIR_${name})
        return()
    endif()
    string(JSON _canton_repository GET "${_canton_dependencies}" "${_canton_name}" repository)
    string(JSON _canton_ref GET "${_canton_dependencies}" "${_canton_name}" ref)
    if(CANTON_${name}_GIT_REPOSITORY STREQUAL _canton_repository AND CANTON_${name}_GIT_TAG STREQUAL _canton_ref)
        string(JSON _canton_commit GET "${_canton_dependencies}" "${_canton_name}" commit)
        find_package(Git REQUIRED QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD RESULT_VARIABLE _canton_git_result OUTPUT_VARIABLE _canton_actual_commit OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT _canton_git_result EQUAL 0 OR NOT _canton_actual_commit STREQUAL _canton_commit)
            message(FATAL_ERROR "${name} checkout does not match the pinned Canton dependency commit")
        endif()
    endif()
endfunction()

function(canton_reject_unclean_dependency_path path label)
  if(NOT path)
    return()
  endif()
  get_filename_component(_canton_dep_abs "${path}" ABSOLUTE)
  if(_canton_dep_abs MATCHES "/_deps(/|$)")
    message(FATAL_ERROR "Refusing ${label}='${_canton_dep_abs}'. Use a clean checkout or Canton-owned FetchContent, not another project's CMake _deps cache.")
  endif()
endfunction()

function(canton_fetch_quickjs_ng)
  # 解释器即使在 Debug 也优化，避免 MSVC 未优化解释循环耗尽宿主线程栈
  # 仅调整本函数添加的依赖目录，Canton 自身保留完整 Debug 检查
  if(MSVC)
    string(REPLACE "/RTC1" "" CMAKE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG}")
  endif()
  if(DEFINED CANTON_QUICKJS_NG_SOURCE_DIR AND NOT CANTON_QUICKJS_NG_SOURCE_DIR STREQUAL "")
    canton_reject_unclean_dependency_path("${CANTON_QUICKJS_NG_SOURCE_DIR}" "CANTON_QUICKJS_NG_SOURCE_DIR")
  endif()
  canton_reject_unclean_dependency_path("${FETCHCONTENT_SOURCE_DIR_QUICKJS_NG}" "FETCHCONTENT_SOURCE_DIR_QUICKJS_NG")

  if(TARGET qjs)
    return()
  endif()

  if(DEFINED CANTON_QUICKJS_NG_SOURCE_DIR AND NOT CANTON_QUICKJS_NG_SOURCE_DIR STREQUAL "")
    get_filename_component(_canton_qjs_dir "${CANTON_QUICKJS_NG_SOURCE_DIR}" ABSOLUTE)
    message(STATUS "Using explicit clean QuickJS-NG checkout: ${_canton_qjs_dir}")
    add_subdirectory("${_canton_qjs_dir}" "${CMAKE_BINARY_DIR}/_deps/quickjs-ng-build")
    if(MSVC)
      target_compile_options(qjs PRIVATE "$<$<CONFIG:Debug>:/O2>")
    endif()
    return()
  endif()

  message(STATUS "Fetching QuickJS-NG ${CANTON_QUICKJS_NG_GIT_TAG} from ${CANTON_QUICKJS_NG_GIT_REPOSITORY}")
  FetchContent_Declare(quickjs_ng
    GIT_REPOSITORY "${CANTON_QUICKJS_NG_GIT_REPOSITORY}"
    GIT_TAG "${CANTON_QUICKJS_NG_GIT_TAG}"
    GIT_SHALLOW TRUE
    GIT_PROGRESS TRUE
  )
  FetchContent_MakeAvailable(quickjs_ng)
  canton_validate_dependency(QUICKJS_NG "${quickjs_ng_SOURCE_DIR}")
  if(MSVC)
    target_compile_options(qjs PRIVATE "$<$<CONFIG:Debug>:/O2>")
  endif()
endfunction()
