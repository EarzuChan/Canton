<template>
    <Box :modifier="M.fillMaxSize()" &box-handle>
        <!-- 底层彩色实景背景，供液态玻璃实时采样与折射 -->
        <Box :modifier="M.fillMaxSize().then(layerBackdrop(rootBackdrop))">
            <Column :modifier="M.fillMaxSize().verticalScroll(scrollState).background(bgGrad).padding(20.dp)" :verticalArrangement="Arrangement.spacedBy(16.dp)">
                <Row :horizontalArrangement="Arrangement.spacedBy(16.dp)">
                    <Box :modifier="M.size(210.dp, 118.dp).background(cardGrad1, rounded(20.dp)).padding(14.dp)">
                        <Column :verticalArrangement="Arrangement.spacedBy(6.dp)">
                            <Text text="LIQUID OPTICS" :style="heading" />

                            <Text text="Drag the glass card across vibrant edges to inspect real-time refraction & chromatic dispersion." :style="caption" />
                        </Column>
                    </Box>

                    <Box :modifier="M.size(210.dp, 118.dp).background(cardGrad2, rounded(20.dp)).padding(14.dp)">
                        <Column :verticalArrangement="Arrangement.spacedBy(6.dp)">
                            <Text text="SPECTRAL PRISM" :style="heading" />

                            <Text text="7-band dispersion splits RGB along rounded-SDF gradients." :style="caption" />
                        </Column>
                    </Box>

                    <Box :modifier="M.size(210.dp, 118.dp).background(cardGrad3, rounded(20.dp)).padding(14.dp)">
                        <Column :verticalArrangement="Arrangement.spacedBy(6.dp)">
                            <Text text="ZERO-LAG TRACK" :style="heading" />

                            <Text text="onGloballyPositioned syncs coordinates before draw on the same frame." :style="caption" />
                        </Column>
                    </Box>
                </Row>

                <Row :horizontalArrangement="Arrangement.spacedBy(14.dp)">
                    <Box :modifier="M.size(96.dp, 96.dp).background(palette.amber, CircleShape)" />

                    <Box :modifier="M.size(160.dp, 96.dp).background(stripeGrad, rounded(18.dp)).padding(12.dp)">
                        <Text text="HIGH CONTRAST" :style="darkBody" />
                    </Box>

                    <Box :modifier="M.size(160.dp, 96.dp).background(palette.emerald, rounded(18.dp)).padding(12.dp)">
                        <Text text="EMERALD BAND" :style="darkBody" />
                    </Box>

                    <Box :modifier="M.size(160.dp, 96.dp).background(palette.rose, rounded(18.dp)).padding(12.dp)">
                        <Text text="CRIMSON BAND" :style="heading" />
                    </Box>
                </Row>

                <Row :horizontalArrangement="Arrangement.spacedBy(14.dp)">
                    <Box :modifier="M.size(310.dp, 130.dp).background(cardGrad4, rounded(20.dp)).padding(16.dp)">
                        <Column :verticalArrangement="Arrangement.spacedBy(8.dp)">
                            <Text text="SCROLLABLE WALLPAPER" :style="heading" />

                            <Text text="Scroll to move the colors beneath the floating glass." :style="body" />
                        </Column>
                    </Box>
                    <Box :modifier="M.size(310.dp, 130.dp).background(cardGrad5, rounded(20.dp)).padding(16.dp)">
                        <Column :verticalArrangement="Arrangement.spacedBy(8.dp)">
                            <Text text="LAYERED REFRACTION" :style="heading" />

                            <Text text="The glass slider thumbs refract the tracks beneath them." :style="body" />
                        </Column>
                    </Box>
                </Row>

                <Row :horizontalArrangement="Arrangement.spacedBy(14.dp)">
                    <Box :modifier="M.size(634.dp, 120.dp).background(cardGrad1, rounded(20.dp)).padding(16.dp)">
                        <Text text="EXTRA SCROLL CONTENT — KEEP SCROLLING" :style="heading" />
                    </Box>
                </Row>
            </Column>
        </Box>

        <!-- 拖动内部移动，拖动边缘或角落缩放 -->
        <Box :modifier="floatingGlassMod" &box-handle>
            <Column :modifier="M.padding(18.dp)" :verticalArrangement="Arrangement.spacedBy(8.dp)">
                <Row :horizontalArrangement="Arrangement.SpaceBetween" :verticalAlignment="Alignment.CenterVertically" :modifier="M.fillMaxWidth()">
                    <Text text="Draggable Liquid Glass" :style="heading" />

                    <!-- 液态玻璃开关 -->
                    <Box :modifier="switchMod">
                        <Text :text="dispersion ? 'Prism ON' : 'Prism OFF'" :style="caption" />
                    </Box>
                </Row>
                <Text :text="`Refract H:${refractionHeight}  Amt:${refractionAmount}  Blur:${blurRadius}  Angle:${highlightAngle}`" :style="caption" />
                <Text :text="`Saturation:${saturation.toFixed(2)}  Pos:(${Math.round(dragX)}, ${Math.round(dragY)})`" :style="caption" />
            </Column>
            <Spacer c-for="region in resizeCursorRegions" :key="region.alignment" :modifier="boxHandle.align(region.alignment).then(region.modifier)" />
        </Box>

        <Box :modifier="boxHandle.align(Alignment.BottomCenter).then(controlCardMod)">
            <Column :modifier="M.fillMaxWidth()" :verticalArrangement="Arrangement.spacedBy(8.dp)">
                <Row :modifier="M.fillMaxWidth()" :horizontalArrangement="Arrangement.SpaceBetween" :verticalAlignment="Alignment.CenterVertically">
                    <Text text="Glass Controls" :style="heading" />
                    <Box :modifier="resetButtonMod">
                        <Text text="Reset" :style="subheading" />
                    </Box>
                </Row>
                <Row c-for="(group, index) in controls" :key="index" &row-handle :modifier="M.fillMaxWidth()" :horizontalArrangement="Arrangement.spacedBy(16.dp)" :verticalAlignment="Alignment.CenterVertically">
                    <Box c-for="control in group" :key="control.label" :modifier="rowHandle.weight(1)">
                        <LiquidSlider c-if="control.slider" :label="control.label" :displayValue="control.slider.display()" :value="control.slider.value()" :min="control.slider.min" :max="control.slider.max" :onValueChange="control.slider.set" :modifier="M.fillMaxWidth()" />
                        <Row c-else :modifier="M.fillMaxWidth()" :horizontalArrangement="Arrangement.SpaceBetween" :verticalAlignment="Alignment.CenterVertically">
                            <Text :text="control.label" :style="subheading" />
                            <Box :modifier="switchMod">
                                <Text :text="dispersion ? 'On' : 'Off'" :style="subheading" />
                            </Box>
                        </Row>
                    </Box>
                </Row>
            </Column>
        </Box>
    </Box>
</template>

<script>
import { computed, ref, createScrollState, createDraggable2DState, type DragStart, type Ref } from '@canton/framework'
import { Alignment, Arrangement, CircleShape, Color, M, TileMode, linearGradient, rounded } from '@canton/framework/ui'
import { Highlight, HighlightStyle, Shadow, createLayerBackdrop, drawBackdrop, layerBackdrop } from '@canton/kyant-glass'
import { body, caption, controlCardColor, darkBody, heading, subheading } from './theme.ts'
import LiquidSlider from './LiquidSlider.cta'

const props = defineProps<{ preset?: number }>()

const palette = {
    amber: Color(0xfffbbf24),
    emerald: Color(0xff34d399),
    rose: Color(0xfff43f5e),
    switchOn: Color(0x8838bdf8),
    switchOff: Color(0x55334155),
}

const bgGrad = linearGradient([Color(0xff1e1b4b), Color(0xff0f172a), Color(0xff134e4a)], { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } })
const cardGrad1 = linearGradient([Color(0xffec4899), Color(0xff8b5cf6)], { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } })
const cardGrad2 = linearGradient([Color(0xff06b6d4), Color(0xff3b82f6)], { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } })
const cardGrad3 = linearGradient([Color(0xfff97316), Color(0xffef4444)], { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } })
const cardGrad4 = linearGradient([Color(0xff22c55e), Color(0xff0ea5e9)], { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } })
const cardGrad5 = linearGradient([Color(0xffeab308), Color(0xffec4899)], { start: { x: 0, y: 0 }, end: { x: 1, y: 1 } })
const stripeGrad = linearGradient([Color(0xfffef08a), Color(0xff38bdf8), Color(0xfff472b6)], { start: { x: 0, y: 0 }, end: { x: 1, y: 0 } })

const scrollState = createScrollState()
const rootBackdrop = createLayerBackdrop()

const dragX = ref(120)
const dragY = ref(88)
const glassWidth = ref(310)
const glassHeight = ref(138)
const refractionHeight = ref(20)
const refractionAmount = ref(28)
const blurRadius = ref(4)
const highlightAngle = ref(45)
const saturation = ref(1.4)
const dispersion = ref(true)

const resizeBorderDp = 10
const cornerSize = M.size(resizeBorderDp.dp, resizeBorderDp.dp)
const diagonalNwse = cornerSize.pointerIcon('resizeNwse')
const diagonalNesw = cornerSize.pointerIcon('resizeNesw')
const topBottomEdge = M.fillMaxWidth().padding({ horizontal: resizeBorderDp.dp }).height(resizeBorderDp.dp).pointerIcon('resizeVertical')
const sideEdge = M.fillMaxHeight().padding({ vertical: resizeBorderDp.dp }).width(resizeBorderDp.dp).pointerIcon('resizeHorizontal')
const resizeCursorRegions = [
    { alignment: Alignment.TopStart, modifier: diagonalNwse },
    { alignment: Alignment.TopCenter, modifier: topBottomEdge },
    { alignment: Alignment.TopEnd, modifier: diagonalNesw },
    { alignment: Alignment.CenterStart, modifier: sideEdge },
    { alignment: Alignment.CenterEnd, modifier: sideEdge },
    { alignment: Alignment.BottomStart, modifier: diagonalNesw },
    { alignment: Alignment.BottomCenter, modifier: topBottomEdge },
    { alignment: Alignment.BottomEnd, modifier: diagonalNwse },
]

let gesture = { x: 0, y: 0, width: 0, height: 0, resizeX: 0, resizeY: 0, dx: 0, dy: 0 }

function startGlassDrag(start: DragStart) {
    gesture = {
        x: dragX.value,
        y: dragY.value,
        width: glassWidth.value,
        height: glassHeight.value,
        resizeX: start.xDp < resizeBorderDp ? -1 : start.xDp >= start.widthDp - resizeBorderDp ? 1 : 0,
        resizeY: start.yDp < resizeBorderDp ? -1 : start.yDp >= start.heightDp - resizeBorderDp ? 1 : 0,
        dx: 0,
        dy: 0,
    }
}

const dragState = createDraggable2DState((delta) => {
    // Keep the full gesture displacement so reversing first retraces any overshoot.
    gesture.dx += delta.xDp
    gesture.dy += delta.yDp
    const { x, y, width, height, resizeX, resizeY, dx, dy } = gesture

    if (!resizeX && !resizeY) {
        dragX.value = Math.max(12, Math.min(540, x + dx))
        dragY.value = Math.max(12, Math.min(340, y + dy))
        return
    }

    if (resizeX) {
        const maxWidth = resizeX < 0 ? Math.min(700, x + width - 12) : 700
        const nextWidth = Math.max(275, Math.min(maxWidth, width + resizeX * dx))
        if (resizeX < 0) dragX.value = x + width - nextWidth
        glassWidth.value = nextWidth
    }

    if (resizeY) {
        const maxHeight = resizeY < 0 ? Math.min(440, y + height - 12) : 440
        const nextHeight = Math.max(120, Math.min(maxHeight, height + resizeY * dy))
        if (resizeY < 0) dragY.value = y + height - nextHeight
        glassHeight.value = nextHeight
    }
})

function slider(label: string, state: Ref<number>, min: number, max: number, digits = 0, suffix = '') {
    return {
        label,
        slider: {
            min,
            max,
            value: () => state.value,
            display: () => `${state.value.toFixed(digits)}${suffix}`,
            set: (value: number) => { state.value = value },
        },
    }
}

const controls = [
    [slider('Lens height', refractionHeight, 0, 40), slider('Refraction', refractionAmount, 0, 64), slider('Blur', blurRadius, 0, 20)],
    [slider('Highlight', highlightAngle, 0, 360, 0, '°'), slider('Saturation', saturation, 0, 2.5, 2), { label: 'Dispersion', slider: undefined }],
]

function resetAll() {
    dragX.value = 120
    dragY.value = 88
    glassWidth.value = 310
    glassHeight.value = 138
    refractionHeight.value = 20
    refractionAmount.value = 28
    blurRadius.value = 4
    highlightAngle.value = 45
    saturation.value = 1.4
    dispersion.value = true
}

const cardShape = rounded(28.dp)

const floatingGlassBackdrop = drawBackdrop({
    backdrop: rootBackdrop,
    shape: () => cardShape,
    effects: (scope) => {
        scope.colorControls({ saturation: saturation.value })
        if (blurRadius.value > 0) scope.blur(blurRadius.value, TileMode.Clamp)
        scope.lens({
            refractionHeight: refractionHeight.value,
            refractionAmount: refractionAmount.value,
            depthEffect: true,
            chromaticAberration: dispersion.value || props.preset === 1,
        })
    },
    highlight: () =>
        Highlight.create({
            widthDp: 1,
            style: HighlightStyle.default({ angle: highlightAngle.value, falloff: 1.2 }),
        }),
    shadow: () => Shadow.create({ radiusDp: 18 }),
    onDrawSurface: (scope) => {
        scope.drawRect({ color: Color(0x18ffffff) })
    },
})

const floatingGlassMod = computed(() =>
    M.offset({ x: dragX.value.dp, y: dragY.value.dp })
        .size(glassWidth.value.dp, glassHeight.value.dp)
        .draggable2D(dragState, { onDragStarted: startGlassDrag })
        .pointerIcon('grab')
        .then(floatingGlassBackdrop),
)

const controlCardMod = M.fillMaxWidth().padding({ horizontal: 16.dp, bottom: 12.dp })
    .background(Color(controlCardColor), rounded(24.dp))
    .padding({ horizontal: 16.dp, vertical: 10.dp })

const resetButtonMod = M.background(Color(0xff393a46), rounded(12.dp))
    .padding({ horizontal: 12.dp, vertical: 5.dp })
    .clickable({ onClick: resetAll })
    .pointerIcon('hand')

const switchMod = computed(() =>
    M.background(dispersion.value ? palette.switchOn : palette.switchOff, rounded(12.dp))
        .padding({ horizontal: 10.dp, vertical: 4.dp })
        .clickable({ onClick: () => { dispersion.value = !dispersion.value } })
        .pointerIcon('hand'),
)

</script>
