<template>
    <Column :modifier="M.fillMaxSize().padding(16.dp)" :verticalArrangement="Arrangement.spacedBy(10.dp)">
        <Text :text="`Scroll at ${offset}`" :style="title" />
        <Row :modifier="M.fillMaxWidth()" :horizontalArrangement="Arrangement.spacedBy(10.dp)" &rowHandle>
            <!-- 竖向滚动：内容比视口高，位置由脚本设定 -->
            <Column :modifier="rowHandle.weight(1).height(220.dp).background(palette.panel, rounded(8.dp)).verticalScroll(vertical).padding(8.dp)" :verticalArrangement="Arrangement.spacedBy(6.dp)">
                <Row c-for="row in rows" :key="row" :modifier="M.fillMaxWidth().height(28.dp).background(row % 2 ? palette.line : palette.canvas, rounded(4.dp)).padding({ horizontal: 8.dp })" &rowHandle="innerHandle">
                    <Text :text="`row ${row}`" :style="body" :modifier="innerHandle.align(Alignment.CenterVertically)" />
                </Row>
            </Column>
            <!-- 横向滚动 -->
            <Row :modifier="rowHandle.weight(1).height(80.dp).background(palette.panel, rounded(8.dp)).horizontalScroll(horizontal).padding(8.dp)" :horizontalArrangement="Arrangement.spacedBy(6.dp)">
                <Box c-for="column in rows" :key="column" :modifier="M.size(48.dp, 64.dp).background(colors[column % colors.length]!, rounded(6.dp))" &boxHandle>
                    <Text :text="`${column}`" :style="body" :modifier="boxHandle.align(Alignment.Center)" />
                </Box>
            </Row>
        </Row>
        <Text text="positions are set from script" :style="caption" />
    </Column>
</template>

<script>
import { createScrollState, watch } from '@canton/framework'
import { M, Alignment, Arrangement, rounded, Color } from '@canton/framework/ui'
import { body, caption, title } from './theme.ts'

const palette = { canvas: Color(0xff0f172a), panel: Color(0xff1e293b), line: Color(0xff334155), sky: Color(0xff38bdf8), pink: Color(0xfff472b6), amber: Color(0xfffbbf24), green: Color(0xff34d399), violet: Color(0xffa78bfa) }

const props = defineProps<{ offset: number }>()
const rows = Array.from({ length: 30 }, (_, index) => index)
const colors = [palette.sky, palette.pink, palette.amber, palette.green, palette.violet]
const vertical = createScrollState()
const horizontal = createScrollState()

// 没有输入的这一期，滚动位置由指令带来的数值设定
watch(() => props.offset, value => {
    vertical.scrollTo(value.px)
    horizontal.scrollTo((value / 2).px)
}, { immediate: true })
</script>
