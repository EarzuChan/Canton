<template>
    <App &appHandle>
        <Window title="Lazy" :onCloseRequest="appHandle.exitApplication">
            <Column :modifier="M.fillMaxSize()">
                <Input value="" :onSubmit="command" :modifier="M.height(30.dp)" />
                <Text :text="`可见:${list.firstVisibleItemIndex}/${list.firstVisibleItemScrollOffsetPx}/${list.layoutInfo.totalItemsCount}`" :modifier="M.height(20.dp)" />
                <LazyColumn c-if="mode === 'column'" :items="items" :itemKey="keyOf" :contentType="typeOf" :state="list" :modifier="M.fillMaxWidth()" &item>
                    <Item :id="item.id" :height="item.height" />
                </LazyColumn>
                <LazyRow c-else-if="mode === 'row'" :items="items" :itemKey="keyOf" :state="list" :modifier="M.fillMaxWidth()" &item>
                    <RowItem :id="item.id" :height="item.height" />
                </LazyRow>
                <LazyVerticalGrid c-else-if="mode === 'verticalGrid'" :items="items" :itemKey="keyOf" :span="spanOf" :state="list" :cells="GridCells.Fixed(3)" :modifier="M.fillMaxWidth()" &item>
                    <Item :id="item.id" :height="item.height" />
                </LazyVerticalGrid>
                <LazyHorizontalGrid c-else-if="mode === 'horizontalGrid'" :items="items" :itemKey="keyOf" :span="spanOf" :state="list" :cells="GridCells.Adaptive(40.dp)" :modifier="M.fillMaxWidth()" &item>
                    <RowItem :id="item.id" :height="item.height" />
                </LazyHorizontalGrid>
                <Text c-else text="已隐藏" />
            </Column>
        </Window>
    </App>
</template>

<script>
import { ref, createLazyState, toRaw } from '@canton/framework'
import { M, GridCells, GridItemSpan } from '@canton/framework/ui'
import Item from './LazyItem.cta'
import RowItem from './RowItem.cta'

const list = createLazyState()
const mode = ref('column')
const items = ref(Array.from({ length: 10000 }, (_, id) => ({ id, height: id % 3 === 0 ? 30 : 20 })))
const keyOf = (item: { id: number }) => item.id
const typeOf = (item: { height: number }) => item.height
const spanOf = (item: { id: number }) => item.id % 11 === 0 ? GridItemSpan.MaxLineSpan : GridItemSpan(1)
function command(value: string) {
    if (value === 'jump') list.scrollToItem(9000, 5.px)
    else if (value === 'pixel') list.scrollTo(220000.px)
    else if (value === 'start') list.scrollToItem(0)
    else if (value === 'insert') items.value = [{ id: -1, height: 50 }, ...items.value]
    else if (value === 'prepend') items.value = [{ id: -2, height: 75 }, ...items.value]
    else if (value === 'unprepend') items.value = toRaw(items.value).filter(item => item.id !== -2)
    else if (value === 'reverse') items.value = [...items.value].reverse()
    else if (value === 'animate') list.animateScrollToItem(100)
    else if (value === 'bad') items.value = [{ id: 0, height: 20 }, { id: 0, height: 30 }]
    else if (value === 'hide') mode.value = 'hidden'
    else if (value === 'show') mode.value = 'column'
    else if (value === 'row' || value === 'verticalGrid' || value === 'horizontalGrid' || value === 'column') mode.value = value
}
</script>
