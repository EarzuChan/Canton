{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "node",
      "./types/canton-globals.d.ts"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@canton/framework": ["packages/framework/src/index.ts"],
      "@canton/reactivity": ["packages/reactivity/src/index.ts"],
      "@canton/shared": ["packages/shared/src/index.ts"],
      "@canton/vite-plugin": ["packages/vite-plugin/src/index.ts"],
      "@canton/framework/foundation": ["packages/framework/src/foundation.ts"],
      "@canton/framework/ui": ["packages/framework/src/ui.ts"],
      "@canton/framework/animation": ["packages/framework/src/animation.ts"],
      "@canton/framework/internal": ["packages/framework/src/internal.ts"],
      "@canton/framework/vite": ["packages/framework/src/vite.ts"],
      "@canton/framework/hot-runtime": ["packages/framework/src/app/hotRuntime.ts"],
      "@canton/compiler": ["packages/compiler/src/index.ts"],
      "@canton/kyant-glass": ["packages/kyant-glass/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "build/**",
    "artifacts/**"
  ]
}
