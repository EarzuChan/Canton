{
  "name": "canton",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli",
    "packages/*"
  ],
  "scripts": {
    "format": "node --import tsx scripts/format-code.ts --write",
    "format:check": "node --import tsx scripts/format-code.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:runtime": "node --import tsx --test tests/runtime/*.test.ts",
    "test:native": "node --import tsx scripts/test-native.ts",
    "test:quickjs": "node --import tsx scripts/test-quickjs-app.ts",
    "test:render": "node --import tsx scripts/render-regression.ts",
    "baseline:update": "node --import tsx scripts/render-regression.ts --update",
    "fixture:live": "node --import tsx scripts/fixture-live.ts",
    "fixture:dist": "node --import tsx scripts/fixture-dist.ts",
    "verify:live-hmr": "node --import tsx scripts/verify-live-hmr.ts",
    "verify:host": "node --import tsx scripts/verify-host.ts",
    "verify:live-recovery": "node --import tsx scripts/verify-live-recovery.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:cta": "node --import tsx scripts/typecheck-cta.ts",
    "build:packages": "node --import tsx scripts/build-internal-packages.ts",
    "sync:version": "node --import tsx scripts/sync-version.ts",
    "verify:version": "node --import tsx scripts/verify-version.ts",
    "sync:modifier-protocol": "node --import tsx scripts/modifier-native-protocol.ts",
    "verify:modifier-protocol": "node --import tsx scripts/modifier-native-protocol.ts --check",
    "verify:native-fetchcontent": "node --import tsx scripts/verify-native-fetchcontent.ts",
    "pack:package": "node --import tsx scripts/pack-npm-package.ts",
    "publish:local": "node --import tsx scripts/publish-local.ts",
    "verify:npm-package": "node --import tsx scripts/verify-npm-package.ts",
    "verify:platform": "node --import tsx scripts/verify-platform.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "source-map-js": "catalog:",
    "tsx": "4.22.3",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  }
}
